# Copy to env.sh (gitignored) and fill in. Every beacon3d/*.sh sources it from the repo root.
# The ${VAR:-...} form lets a value given on the command line override this file.
# Unset variables fall back to the defaults listed in each script's header.

# --- environment ---
export CHATSCENE_ENV="${CHATSCENE_ENV:-/path/to/chat-scene-venv}"    # venv made by beacon3d/build_env.sh (or extra_eval/build_env_cu128.sh on Blackwell GPUs)
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/cache/uv}"
export HF_HOME="${HF_HOME:-/path/to/cache/huggingface}"              # Vicuna download lands here
# export TMPDIR=/path/to/tmp
# Java (8+) for pycocoevalcap (Scan2Cap/ScanQA/SQA3D scorers), if not on PATH:
# export JAVA_HOME=/path/to/jre; export PATH="$JAVA_HOME/bin:$PATH"

# --- inference (beacon3d/run_beacon3d.sh, extra_eval/run_extra_eval.sh) ---
export CKPT="${CKPT:-/path/to/chat-scene/pretrained/ckpt_01_3446.pth}"
export OFFICIAL_DIR="${OFFICIAL_DIR:-/path/to/chat-scene/annotations}"
# export LLAMA=lmsys/vicuna-7b-v1.5        # HF id or local path
export REAL3DQA_DIR="${REAL3DQA_DIR:-/path/to/Real-3DQA}"           # <split>.jsonl from HF Oliver-Ma/Real-3DQA
# export NGPU=2
# export BATCH_SIZE=32

# --- scoring (score.sh) ---
export OPENAI_API_KEY="${OPENAI_API_KEY:-sk-...}"

# --- rebuilding beacon3d/features (extract_uni3d.sh) ---
# export UNI3D_CKPT=/path/to/uni3d-g/model.pt
# export RSCAN_SCAN_DATA=/path/to/SceneVerse/3RScan/scan_data
# export MULTISCAN_SCAN_DATA=/path/to/SceneVerse/MultiScan/scan_data
# export SCANNET_SCANS=/path/to/scannet/scans
