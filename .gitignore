__pycache__/
log/
# downloads from Chat-Scene's Hugging Face release and the generated Beacon3D annotations
annotations/
pretrained/
# generated by beacon3d/build_annos.py on every run
scripts/beacon3d_config.py
# generated by extra_eval/build_annos.py on every run
scripts/extra_eval_config.py
# aborted runs, kept locally
outputs/failed_*/
# local python envs
.venv-cu128/
# run logs inside output dirs
outputs/*/train.log
# local python env
.venv/
# local cluster launchers, local paths/secrets and run logs (see env.sh.example)
*.sbatch
env.sh
*.log
# local copies (hard links / symlinks) of every external dependency, see README
deps/
# generated by xr_eval/build_xr.py on every run
scripts/xr_config.py
# XR per-region features (xr_eval/extract_uni3d.sh, render_videofeats.sh; ~400 MB, regenerable)
xr_eval/features/
# finetuned checkpoints (1.3 GB each)
outputs/*/ckpt_*.pth
# per-shard intermediates of xr_eval/register_regions.sh (merged into region_offsets.json)
xr_eval/data/*.shard*
